# EditorConfig — consistent coding styles across editors and IDEs
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python — 4-space indent, ruff line-length 110 (see pyproject.toml)
[*.py]
indent_size = 4
max_line_length = 110

# Frontend (web/) — 2-space indent
[*.{ts,tsx,js,jsx,mjs,cjs,json,css}]
indent_size = 2

# Config / infra
[*.{yml,yaml,toml}]
indent_size = 2

[{Dockerfile*,*.sh}]
indent_size = 2

# Markdown — keep trailing whitespace (line breaks) and don't reflow
[*.md]
trim_trailing_whitespace = false

# Generated / vendored — leave as-is
[{uv.lock,package-lock.json}]
insert_final_newline = false
trim_trailing_whitespace = false
