# Neo Chat factory profile — copy to .env and fill sidecar credentials
# Sidecars: ./predictive-maintenance-mcp, ./DeepAnalyze/API, ./dify/docker
# Start: ./scripts/start_sidecars.sh all

APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_USER=spark
POSTGRES_PASSWORD=sparkpass
POSTGRES_DB=spark_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

REDIS_URL=redis://localhost:6380/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=spark_docs

# Production fail-closes auth via APP_ENV=production; keep this true for clarity.
AUTH_REQUIRED=true
JWT_SECRET=rotate-me-before-factory-demo
CORS_ORIGINS=http://localhost:3000

# ── Google OAuth (production) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_APP_URL=https://spark.yourplant.example
GOOGLE_OAUTH_CALLBACK_URL=https://api.yourplant.example/api/v1/auth/google/callback
GOOGLE_OAUTH_ALLOWED_DOMAINS=yourcompany.co.th
GOOGLE_OAUTH_DEFAULT_ROLE=viewer
GOOGLE_OAUTH_DEFAULT_FACTORY_ID=F-01
NEXT_PUBLIC_SPARK_API_URL=https://api.yourplant.example
NEXT_PUBLIC_PASSWORD_LOGIN=false

LLM_PROFILE=gemma
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=BAAI/bge-m3

RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── UC1 + UC3: predictive-maintenance-mcp (:8100) ───────────────────────────
PREDICTIVE_BACKEND=hybrid
MCP_PREDICTIVE_URL=http://127.0.0.1:8100/mcp
MCP_PREDICTIVE_FALLBACK=true
MCP_IMAGE_TAG=spark-predictive-mcp:0.1.0

# ── Core RAG — native Spark pipeline only ───────────────────────────────────
INGEST_BACKEND=native

# ── UC2: DeepAnalyze (vLLM :8001, API :8200, file :8102) ───────────────────
INVENTORY_REPORT_BACKEND=deepanalyze
DEEPANALYZE_API_URL=http://127.0.0.1:8200/v1
DEEPANALYZE_API_KEY=

# ── Observability ───────────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

# Optional: local Whisper sidecar for voice input (Web Speech remains fallback)
# WHISPER_API_URL=http://127.0.0.1:9000
