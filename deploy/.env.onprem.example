# Neo Chat — On-Premise / Factory Intranet
# Copy to deploy/.env before running ./deploy/setup_onprem.sh
#
# DNS: point spark.lan (or your hostname) to this server's LAN IP.
# All factory tablets/PCs access http://spark.lan (port 80 via nginx).

# ── Public URL (used at web build time + OAuth callbacks) ───────────────────
ONPREM_PUBLIC_URL=http://spark.lan
ONPREM_HTTP_PORT=80
WEB_APP_URL=http://spark.lan
NEXT_PUBLIC_SPARK_API_URL=http://spark.lan
GOOGLE_OAUTH_CALLBACK_URL=http://spark.lan/api/v1/auth/google/callback
CORS_ORIGINS=http://spark.lan

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
AUTH_REQUIRED=true
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
NEXT_PUBLIC_PASSWORD_LOGIN=true

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=spark
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=spark_db
POSTGRES_SQL_READONLY_USER=spark_sql_readonly
POSTGRES_SQL_READONLY_PASSWORD=CHANGE_ME_sql_readonly_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ── Redis / Qdrant ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=512mb
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=spark_docs
QDRANT_SHARD_STRATEGY=single

# ── Object storage (MinIO in-stack) ─────────────────────────────────────────
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=spark-documents
S3_REGION=ap-southeast-1
MINIO_ROOT_USER=sparkminio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# ── Local LLM (Ollama container — no cloud required) ────────────────────────
# Profiles: rag_th (recommended 7B), demo (3B, faster), rag_th needs more RAM
LLM_PROFILE=rag_th
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m
# Embeddings use sentence-transformers (BAAI/bge-m3) inside API/worker — not Ollama
OLLAMA_API_KEY=

# ── Ingestion ────────────────────────────────────────────────────────────────
INGEST_BACKEND=native
MAX_UPLOAD_BYTES=52428800
INGEST_TEMP_DIR=./.cache/ingest

# ── RAG / reranker ───────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_MAX_CANDIDATES=64
RAG_RETRIEVE_MULTIPLIER=3
RAG_MAX_DOCS=3
RAG_LLM_TIMEOUT_SEC=120

# ── Predictive maintenance ───────────────────────────────────────────────────
# heuristic = repair history only (default, no extra container)
# hybrid = enable MCP sidecar: ./deploy/setup_onprem.sh --with-mcp
PREDICTIVE_BACKEND=heuristic
MCP_PREDICTIVE_URL=http://predictive_mcp:8100/mcp
MCP_PREDICTIVE_FALLBACK=true
MCP_IMAGE_TAG=spark-predictive-mcp:0.1.0

# ── Performance tuning (factory server) ───────────────────────────────────────
# Sizing guide (concurrent operators | API workers | db_pool_size | Redis memory):
#   ≤30  → 2 workers | DB_POOL_SIZE=20 | REDIS_MAXMEMORY=256mb
#   ≤100 → 4 workers | DB_POOL_SIZE=30 | REDIS_MAXMEMORY=512mb
ONPREM_API_WORKERS=2
CELERY_CONCURRENCY=2
CELERY_SHM_SIZE=2gb
POSTGRES_MEMORY_LIMIT=4g
QDRANT_MEMORY_LIMIT=2g
API_MEMORY_LIMIT=4g
CELERY_MEMORY_LIMIT=8g
OLLAMA_MEMORY_LIMIT=16g

# ── Data directories (host bind mounts under deploy/data/) ────────────────────
SPARK_DATA_DIR=./data

# ── Google OAuth (optional — leave blank for password-only intranet) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=factory.local

# ── LangSmith / cloud telemetry (disabled for air-gapped LAN) ────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# ── SQL / RCA timeouts ───────────────────────────────────────────────────────
SQL_STATEMENT_TIMEOUT_MS=8000
RCA_LLM_TIMEOUT_SEC=15
