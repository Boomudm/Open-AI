# Neo Chat — Jetson AGX Orin compute node
# Copy to repo root:  cp deploy/jetson/.env.jetson.example .env
# Then set OLLAMA_API_KEY and adjust LAN IPs.

APP_ENV=development
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_STARTUP=true

# ── Infra (Docker on Jetson — same ports as docker-compose.yml) ───────────────
POSTGRES_USER=spark
POSTGRES_PASSWORD=sparkpass
POSTGRES_DB=spark_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6380/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=spark_docs
QDRANT_SHARD_STRATEGY=single

# ── LLM via gateway (Mac/Jetson do NOT run the 35B model) ─────────────────────
LLM_PROFILE=gemma_remote
OLLAMA_API_KEY=REPLACE_WITH_YOUR_GATEWAY_KEY
LLM_HTTP_USER_AGENT=spark-factory/1.0

# ── Embedding + rerank on Jetson GPU ────────────────────────────────────────
# bge-m3 is locked in configs/llm_profiles.yaml — no override needed.
RAG_RERANK_DEVICE=cuda
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Do NOT set SPARK_ALLOW_CPU_RERANK on Jetson.

# ── Storage (MinIO in Docker) ───────────────────────────────────────────────
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=spark-documents
S3_ACCESS_KEY=sparkminio
S3_SECRET_KEY=sparkminio
S3_REGION=ap-southeast-1
MINIO_ROOT_USER=sparkminio
MINIO_ROOT_PASSWORD=sparkminio

INGEST_BACKEND=native
INGEST_TEMP_DIR=./.cache/ingest
INBOX_DIR=./data/inbox
RAW_DIR=./data/raw
DOCUMENTS_DIR=./data/documents
MACHINES_DIR=./data/machines
FEEDBACK_DIR=./data/feedback
CHAT_ATTACHMENTS_DIR=./data/chat_attachments

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_REQUIRED=true
JWT_SECRET=change-me-on-jetson-use-openssl-rand-hex-32
# Mac browser at :3000 proxies API — allow Next dev origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Pools (Orin 32GB — tune down if OOM during ingest+chat) ─────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
CELERY_CONCURRENCY=1

# ── Optional: static Jetson LAN IP for status scripts ───────────────────────
# JETSON_LAN_IP=192.168.1.50
