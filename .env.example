# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Run `alembic upgrade head` automatically at API startup (local dev convenience)
RUN_MIGRATIONS_ON_STARTUP=true

# ── PostgreSQL (host port 5433 to avoid clash with local installs) ───────────
POSTGRES_USER=spark
POSTGRES_PASSWORD=sparkpass
POSTGRES_DB=spark_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Connection pool tuning (async SQLAlchemy)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
SQL_READONLY_POOL_SIZE=5
SQL_READONLY_MAX_OVERFLOW=10
# Text-to-SQL read-only role (created by alembic 0031_sql_readonly_rls)
POSTGRES_SQL_READONLY_USER=spark_sql_readonly
POSTGRES_SQL_READONLY_PASSWORD=spark_sql_readonly_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=spark_docs

# ── LLM profile (see configs/llm_profiles.yaml) ──────────────────────────────
# demo | rag_th | prod (vLLM on :8001)
LLM_PROFILE=demo

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=BAAI/bge-m3
OLLAMA_EMBED_DIM=1024
# API key for an OpenAI-compatible gateway (e.g. proxy.py / api.kcalsion.com); blank for native Ollama
OLLAMA_API_KEY=
# Separate key for /v1/embeddings when the gateway requires it
OLLAMA_EMBED_API_KEY=
# User-Agent sent on OpenAI-compatible gateway requests (WAF allowlist)
LLM_HTTP_USER_AGENT=spark-factory/1.0

# ── ForgeNode (forge.kcalsion.com) — chat + embed + rerank ───────────────────
# When set, dense embed + rerank prefer Forge over GPU sidecar / local models.
# Use LLM_PROFILE=forge_remote or keep gemma_remote and set FORGE_BASE_URL only.
# FORGE_BASE_URL=https://forge.kcalsion.com
# FORGE_API_KEY=replace-with-your-forge-chat-key
# FORGE_EMBED_API_KEY=replace-with-your-forge-embed-key
# FORGE_RERANK_API_KEY=
# FORGE_EMBED_MODEL=bge-m3
# FORGE_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# FORGE_TIMEOUT_SEC=30
# FORGE_RERANK_ENABLED=true
# GPU sidecar (optional fallback when Forge is unset): GPU_SIDECAR_URL=http://127.0.0.1:8765
OLLAMA_LLM_TEMPERATURE=0.1
OLLAMA_LLM_NUM_CTX=4096

# ── Ingestion ────────────────────────────────────────────────────────────────
INBOX_DIR=./data/inbox
RAW_DIR=./data/raw
DOCUMENTS_DIR=./data/documents
MACHINES_DIR=./data/machines
FEEDBACK_DIR=./data/feedback
MAX_FEEDBACK_PHOTO_BYTES=5242880
MAX_FEEDBACK_PHOTOS=3
MAX_FEEDBACK_COMMENT_CHARS=500
MAX_CHAT_ATTACHMENT_BYTES=10485760
MAX_CHAT_ATTACHMENTS_PER_MESSAGE=3
MAX_CHAT_ATTACHMENT_EXTRACT_CHARS=8000
CHAT_ATTACHMENTS_DIR=./data/chat_attachments
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=52428800
MAX_MACHINE_IMAGE_BYTES=2097152
INGEST_TEMP_DIR=./.cache/ingest
INGEST_TEMP_TTL_SECONDS=3600
CONFIG_DIR=./configs/ingestion
# S3 / MinIO — set STORAGE_BACKEND=s3 (docker dev-app overlay sets this automatically)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=spark-documents
# S3_ACCESS_KEY=sparkminio
# S3_SECRET_KEY=sparkminio
# S3_REGION=ap-southeast-1
# MINIO_ROOT_USER=sparkminio
# MINIO_ROOT_PASSWORD=sparkminio
# native only — sole production ingest/RAG spine (Phase 13)
INGEST_BACKEND=native

# ── Auth (default in config: AUTH_REQUIRED=true; override below for local demo) ─
# Local dev only. Production (`APP_ENV=production`) enforces auth even if this is false.
AUTH_REQUIRED=false
# Must match API JWT_SECRET — used by Next.js middleware to verify session cookies
JWT_SECRET=dev-secret-change-me
# Comma-separated origins in production (e.g. http://localhost:3000)
CORS_ORIGINS=*

# ── Qdrant sharding ──────────────────────────────────────────────────────────
# single | per_factory | per_factory_category
QDRANT_SHARD_STRATEGY=single

# ── Reranker & RAG retrieval ─────────────────────────────────────────────────
# Cross-encoder model (pipeline: dense + lexical → RRF → cross-encoder → gate)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_MAX_CANDIDATES=64
RAG_RETRIEVE_MULTIPLIER=3
RAG_MAX_DOCS=3
RAG_MAX_CHUNKS_PER_DOC=2
RAG_QUERY_EMBEDDING_CACHE_TTL=300
RAG_LLM_TIMEOUT_SEC=60
RAG_RRF_K=60
RAG_LEXICAL_SCAN_LIMIT=1500
RAG_LEXICAL_MIN_SCORE=0.18
RAG_PG_TRGM_SIMILARITY_FLOOR=0.08
CONTEXT_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_MARGIN_TOKENS=64
CHAT_HISTORY_MAX_TURNS=10
QUESTION_MAX_LENGTH=3000
QUERY_COMPRESS_CHAR_THRESHOLD=500
QUERY_COMPRESS_PROFILE=tagging
TOKEN_COUNTER_BACKEND=auto
ROUTER_LLM_ENABLED=false
ROUTER_LLM_CONFIDENCE_THRESHOLD=0.7
ROUTER_LLM_PROFILE=tagging
ROUTING_MODE=legacy
AGENTIC_CANARY_PCT=0
AGENTIC_CIRCUIT_WINDOW_SEC=600
AGENTIC_CIRCUIT_ERROR_RATE_THRESHOLD=0.10
AGENTIC_CIRCUIT_FLAG_PATH=./data/agentic/circuit_open.flag
QA_CACHE_ENABLED=false
QA_CACHE_TTL_DAYS=90

# ── Text-to-SQL semantic validation ─────────────────────────────────────────
SQL_SEMANTIC_VALIDATION=true
SQL_SELF_CONSISTENCY_N=1
SQL_JUDGE_MIN_CONFIDENCE=0.7
SQL_JUDGE_PROFILE=judge
SQL_LLM_TIMEOUT_SEC=45
SQL_STATEMENT_TIMEOUT_MS=8000
# External Postgres data sources (admin live query) — use a strong random key in production
DATA_SOURCE_ENCRYPTION_KEY=

# ── LangSmith (optional) ─────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=spark-v3

# ── Root-cause analysis ──────────────────────────────────────────────────────
RCA_DB_TIMEOUT_SEC=5
RCA_RAG_TIMEOUT_SEC=12
RCA_LLM_TIMEOUT_SEC=10
RCA_FAST_PATH_ENABLED=true
RCA_FAST_PATH_MIN_REPAIRS=3
RCA_FAST_PATH_MIN_PCT=60

# ── OCR / speech (optional) ──────────────────────────────────────────────────
OCR_CONFIDENCE_ALERT_MIN=70
WHISPER_ENABLED=false
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_MAX_SECONDS=30
WHISPER_MAX_BYTES=5242880

# ── Predictive maintenance (factory: hybrid + MCP sidecar) ─────────────────
PREDICTIVE_BACKEND=heuristic
MCP_PREDICTIVE_URL=http://127.0.0.1:8100/mcp
MCP_PREDICTIVE_TIMEOUT_SEC=30
MCP_PREDICTIVE_FALLBACK=true
MCP_IMAGE_TAG=spark-predictive-mcp:0.1.0

# ── Inventory analyst reports ───────────────────────────────────────────────
# native | deepanalyze
INVENTORY_REPORT_BACKEND=native
DEEPANALYZE_API_URL=
DEEPANALYZE_API_KEY=

# ── Observability (Grafana / Prometheus) ─────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Register redirect URI in Google Cloud Console. Prefer the public web origin
# so the browser stays on the same site and Next.js proxies /api to FastAPI:
#   https://app.example.com/api/v1/auth/google/callback
# Local backend-direct callback also works when registered:
#   http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public frontend origin used after Google callback.
WEB_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SPARK_API_URL=http://127.0.0.1:8000
# Server-side API URL override for Next.js rewrites (Docker / LAN)
SPARK_API_URL=
# GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/v1/auth/google/callback
# Comma-separated email domains allowed for Google auto-signup (production: required)
# GOOGLE_OAUTH_ALLOWED_DOMAINS=yourcompany.co.th
# GOOGLE_OAUTH_DEFAULT_ROLE=employee
# GOOGLE_OAUTH_DEFAULT_FACTORY_ID=F-01
# AUTH_TOKEN_VERSION_CACHE_TTL=45
# Worker UI: hide password login when false
# NEXT_PUBLIC_PASSWORD_LOGIN=false

# Insights Phase 2 (optional)
# INSIGHTS_HOTNESS_THRESHOLD=5.0
INSIGHTS_CORRELATION_SPIKE_RATIO=2.0
# TOPIC_TAG_CONFIDENCE_MIN=0.5
# TOPIC_TAG_BATCH_LIMIT=500
# TOPIC_TAG_LOOKBACK_DAYS=90
