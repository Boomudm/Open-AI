# Neo Chat — kcalsion factory deploy (Lenovo server)
# Copy to .env on server:  cp .env.kcalsion.example .env
# Fill JWT_SECRET, POSTGRES_PASSWORD, and MinIO secrets (generate offline):
#   openssl rand -hex 16   # use same value for S3_SECRET_KEY and MINIO_ROOT_PASSWORD
# Do NOT commit .env.

APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_USER=spark
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_16
POSTGRES_DB=spark_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

REDIS_URL=redis://localhost:6380/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=spark_docs

AUTH_REQUIRED=true
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# LAN first; add https://spark.kcalsion.com after Cloudflare Tunnel is live
CORS_ORIGINS=http://spark.lan,http://localhost:3000

# LLM — profile gemma → qwen3.6:35b-a3b + embeddinggemma via host proxy :9090
# (see configs/llm_profiles.yaml; model names below are documentation only)
LLM_PROFILE=gemma
OLLAMA_API_KEY=ck-openrte-web-2026
OLLAMA_LLM_MODEL=qwen3.6:35b-a3b
OLLAMA_EMBED_MODEL=embeddinggemma:latest
OLLAMA_EMBED_DIM=768
LLM_HTTP_USER_AGENT=curl/8.5.0

# Web build-time URLs (rebuild web after changing)
NEXT_PUBLIC_SPARK_API_URL=http://spark-api.lan
NEXT_PUBLIC_PASSWORD_LOGIN=true

# Minimal factory — enable sidecars later
PREDICTIVE_BACKEND=heuristic
INGEST_BACKEND=native
RERANKER_STRATEGY=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Object storage — MinIO (docker compose minio service on :9000, console :9001)
# Host scripts / mc CLI: http://127.0.0.1:9000 — Docker api/celery use http://minio:9000 (compose override)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=spark-documents
S3_ACCESS_KEY=sparkminio
S3_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_16
S3_REGION=ap-southeast-1
MINIO_ROOT_USER=sparkminio
MINIO_ROOT_PASSWORD=CHANGE_ME_use_openssl_rand_hex_16

# Backup script paths (host paths; bind-mount ./data/raw in kcalsion compose)
SPARK_DATA=./data/raw
BACKUP_ROOT=/var/backups/spark

# ── Google OAuth (enable after go-live) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_APP_URL=https://spark.kcalsion.com
GOOGLE_OAUTH_CALLBACK_URL=https://spark-api.kcalsion.com/api/v1/auth/google/callback
GOOGLE_OAUTH_ALLOWED_DOMAINS=yourcompany.co.th
GOOGLE_OAUTH_DEFAULT_ROLE=viewer
GOOGLE_OAUTH_DEFAULT_FACTORY_ID=F-01

PROMETHEUS_URL=http://localhost:9090
