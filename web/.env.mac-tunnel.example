# Mac thin client — API on Jetson via SSH tunnel (no direct LAN to :8000)
#
# Terminal 1:
#   chmod +x scripts/jetson/ssh_tunnel_mac.sh
#   JETSON_USER=jetson JETSON_HOST=10.11.98.156 ./scripts/jetson/ssh_tunnel_mac.sh
#
# Terminal 2:
#   cp .env.mac-tunnel.example .env.local
#   npm run dev

SPARK_API_PROXY_TARGET=http://127.0.0.1:8000
SPARK_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SPARK_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PASSWORD_LOGIN=true

# Must match JWT_SECRET in Jetson .env (or root .env on Mac dev).
# Without this, Next.js falls back to "dev-secret-change-me" and session cookies fail verify → "session expired".
# On Jetson: grep JWT_SECRET .env
# After changing .env.local, restart: npm run dev
JWT_SECRET=copy-from-jetson-env-openssl-rand-hex-32
