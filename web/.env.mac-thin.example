# Mac thin client — Next.js on Mac, API + workers on Jetson
# Copy: cp .env.mac-thin.example .env.local  then set Jetson IP
#
# --- Direct LAN (Jetson :8000 reachable from Mac) ---
# SPARK_API_PROXY_TARGET=http://10.11.98.156:8000
#
# --- SSH tunnel (see scripts/jetson/ssh_tunnel_mac.sh) ---
# cp .env.mac-tunnel.example .env.local
# SPARK_API_PROXY_TARGET=http://127.0.0.1:8000

# Next.js dev proxy target (preferred for rewrites in next.config.mjs)
SPARK_API_PROXY_TARGET=http://10.11.98.156:8000

# Same origin for server-side helpers (Google OAuth redirect, NOC debug links)
SPARK_API_URL=http://10.11.98.156:8000
NEXT_PUBLIC_SPARK_API_URL=http://10.11.98.156:8000

# Password login on LAN dev (Jetson may disable in production)
NEXT_PUBLIC_PASSWORD_LOGIN=true

# Must match JWT_SECRET in Jetson .env — Next.js middleware verifies session cookies with this.
# Missing/wrong value → verify fails → login looks OK but session drops ("session expired").
# After editing .env.local, restart npm run dev (Next reads env at start only).
JWT_SECRET=copy-from-jetson-env-openssl-rand-hex-32
