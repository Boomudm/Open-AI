{
  "title": "Neo Chat Overview",
  "uid": "spark-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Requests/s",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(spark_http_requests_total[1m]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency (s)",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(spark_http_request_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Embedding latency (s)",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(spark_embedding_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(spark_embedding_seconds_bucket[5m])))",
          "refId": "B",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAG scope broadening (rate)",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (fallback_level) (rate(spark_rag_scope_broadened_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingestion rows by outcome",
      "id": 5,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(spark_ingest_rows_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
